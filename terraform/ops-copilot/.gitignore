# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, except the example
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Ignore override files as they are usually used only locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include fake override files for testing to prevent accidental checkout of personal overrides
!example_override.tf
!example_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
