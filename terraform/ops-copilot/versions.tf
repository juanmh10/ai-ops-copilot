terraform {
  required_version = ">= 1.5.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 5.30.0"
    }
    google-beta = {
      source  = "hashicorp/google-beta"
      version = ">= 5.30.0"
    }
  }

  # Remote Backend Configuration (can be enabled for team state persistence)
  # backend "gcs" {
  #   bucket = "enterprise-tfstate-bucket"
  #   prefix = "apps/ai-ops-copilot/prod"
  # }
}

provider "google" {
  project = var.project_id
  region  = var.region
}

provider "google-beta" {
  project = var.project_id
  region  = var.region
}
