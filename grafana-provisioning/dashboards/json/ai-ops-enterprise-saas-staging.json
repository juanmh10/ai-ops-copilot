            "uid": "gcp-billing"
          },
          "editorMode": "code",
          "format": 1,
          "location": "US",
          "rawQuery": true,
          "rawSql": "WITH billing AS (\n  SELECT invoice.month AS invoice_month, project.id AS project_id,\n    service.description AS service_name, currency, cost,\n    COALESCE((SELECT SUM(c.amount) FROM UNNEST(credits) c), 0) AS credit_amount\n  FROM `billing_export.gcp_billing_export_v1_*`\n  WHERE project.id = 'enterprise-saas-staging'\n), latest AS (SELECT MAX(invoice_month) AS month FROM billing)\nSELECT FORMAT_DATE('%m/%Y', PARSE_DATE('%Y%m', invoice_month)) AS Fatura,\n  currency AS Moeda, ROUND(SUM(cost), 2) AS Bruto,\n  ROUND(-SUM(credit_amount), 2) AS Creditos,\n  ROUND(SUM(cost + credit_amount), 2) AS Liquido\nFROM billing WHERE invoice_month = (SELECT month FROM latest)\nGROUP BY invoice_month, currency",
          "refId": "A"
        }
      ],
      "title": "Resumo da última fatura disponível",
      "type": "table"
